# Copy this file to .env for LOCAL testing only (never commit the real .env)
# In production, set these in the Vercel dashboard:
# Project → Settings → Environment Variables

# ✅ REQUIRED — Powers the AI chat
# Get a FREE key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ✅ REQUIRED — Powers "Continue with Google" login
# Get from https://console.cloud.google.com → APIs & Services → Credentials → OAuth Client ID
# Note: Client SECRET is NOT needed — Google One Tap works with Client ID only
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com

# Optional — Weather data (has built-in fallback demo key)
# Get from https://openweathermap.org/api
WEATHER_API_KEY=your-openweathermap-key-here

# Optional — Market prices (has built-in fallback public key)
# Get from https://data.gov.in
MARKET_API_KEY=your-datagov-key-here
